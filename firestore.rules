rules_version = '2';
// FlowFire: cada pessoa só lê e grava os próprios documentos.
// Caminho: canais/{oficial|teste}/usuarios/{uid}/docs/{documento}
service cloud.firestore {
  match /databases/{database}/documents {
    match /canais/{canal}/usuarios/{uid}/docs/{doc} {
      allow read, write: if request.auth != null
        && request.auth.uid == uid
        && canal in ['oficial', 'teste'];
    }
  }
}
